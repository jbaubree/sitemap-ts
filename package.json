{
  "name": "sitemap-ts",
  "type": "module",
  "version": "2.4.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Sitemap generator for TypeScript projects",
  "author": "JB Aubrée <jb.aubree@protonmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/jbaubree/sitemap-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbaubree/sitemap-ts.git"
  },
  "bugs": {
    "url": "https://github.com/antfu/sitemap-ts/issues"
  },
  "keywords": [
    "Sitemap",
    "Typescript",
    "Generator",
    "Robots",
    "Sitemap.xml",
    "Robots.txt"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "nr build",
    "release": "bumpp --commit --push --tag && pnpm publish",
    "start": "esno src/index.ts",
    "test": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "up": "taze major -r -I"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "fast-glob": "^3.3.3",
    "sitemap": "^10.0.0",
    "xml-formatter": "^3.7.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@antfu/ni": "^30.6.0",
    "@babel/types": "^8.1.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "esno": "^4.8.0",
    "lint-staged": "^17.6.1",
    "pnpm": "^9.15.9",
    "rimraf": "^6.1.4",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.3.0",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md}": [
      "eslint --fix"
    ]
  }
}
